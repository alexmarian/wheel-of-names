# Copy to .env.deploy and fill in values (never commit .env.deploy).
# VPS connection + host-path config used by deploy.sh. Kept out of git so the
# host/user/paths aren't disclosed in the repo.

VPS_USER=youruser
VPS_HOST=your.vps.host.or.ip
SSH_KEY=$HOME/.ssh/id_yourkey
# Relative to the VPS user's home. Do NOT use ~ here: this file is sourced by
# your local shell, so ~ would expand to your LOCAL home path.
REMOTE_DIR=containers/wheel-of-names

# Absolute path on the VPS where the sqlite data dir is bind-mounted into the
# container at /data. Must be absolute (docker compose resolves relative
# volume paths against the LOCAL compose file dir, not the remote context).
DATA_DIR_HOST=/home/youruser/containers/wheel-of-names/data

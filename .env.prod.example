# Copy to .env.prod and fill in values (never commit .env.prod).
# Same environment shape as the other doxbit services.

# Public production origin(s), comma-separated. The SPA is same-origin in prod
# so this mainly matters for dev/tooling. e.g. https://wheel.yourdomain.com
ALLOWED_ORIGIN=https://wheel.yourdomain.com

# UTC cron schedule for the nightly "previous day" snapshot job.
SNAPSHOT_CRON=50 23 * * *

# Port the container listens on internally (caddy proxies to :3000).
PORT=3000
DATA_DIR=/data

# Shared secret required to register a new team (POST /api/teams). Leave
# unset/empty to allow open registration.
REGISTRATION_SECRET=
